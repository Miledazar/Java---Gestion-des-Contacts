	private void populateGroupCheckboxes() {
        groupPanel.removeAll();
        Set<Group> groupSet = groupController.getAllGroups();
        
        for (Group group : groupSet) {
            JCheckBox checkBox = new JCheckBox(group.getName());
            groupPanel.add(checkBox);
        }
        groupPanel.revalidate();
        groupPanel.repaint();
    }
	
	public void saveContact() {
		String firstName = firstNameField.getText().trim();
		String lastName = lastNameField.getText().trim();
		String cityName = cityNameField.getText().trim();
		String pn= phoneNumberField.getText().trim();
		
		if(firstName.isEmpty() || lastName.isEmpty() || cityName.isEmpty() || pn.isEmpty()) {
			JOptionPane.showMessageDialog(null, "All fields must be filled out", "Error", JOptionPane.ERROR_MESSAGE);
		}
		
		Contact newContact = new Contact(firstName, lastName, cityName);
		newContact.addPhoneNumber(pn);
        contactController.addContact(newContact);
        
        for (Component c : groupPanel.getComponents()) {
            if (c instanceof JCheckBox checkBox && checkBox.isSelected()) {
                String groupName = checkBox.getText();
                Group group = groupController.findGroupByName(groupName);
                if (group != null) {
                    newContact.addGroup(group);
                }
                
            }
        }
        
        JOptionPane.showMessageDialog(null, "Contact added successfully!");
        
        dispose(); 
	
	}
