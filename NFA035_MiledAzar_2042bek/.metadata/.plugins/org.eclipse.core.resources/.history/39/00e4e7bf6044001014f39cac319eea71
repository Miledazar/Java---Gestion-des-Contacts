    // Get all Groups
    public Set<Group> getAllGroups() {
        return new HashSet<>(groups);
    }

    // Find Group By Name
    
    public Group findGroupByName(String name) {
        for (Group group : groups) {
            if (group.getName().equalsIgnoreCase(name)) {
                return group;
            }
        }
        return null;
    }
    

    // Search groups by name prefix
    public ArrayList<Group> searchGroupByNamePrefix(String prefix) {
        ArrayList<Group> result = new ArrayList<>();
        for (Group group : groups) {
            if (group.getName().toLowerCase().startsWith(prefix.toLowerCase())) {
                result.add(group);
            }
        }
        return result;
    }

    // Sort groups by name
    public ArrayList<Group> getGroupsSortedByName() {
        ArrayList<Group> sorted = new ArrayList<>(groups);
        sorted.sort((g1, g2) -> g1.getName().compareToIgnoreCase(g2.getName()));
        return sorted;
    }
}

