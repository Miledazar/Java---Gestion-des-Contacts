    // Add Group
    public void addGroup(Group group) {
        groups.add(group);
        DataManager.saveGroups(groups);
        notifyObservers();
    }

    // Remove Group
    public void removeGroup(Group group) {
        groups.remove(group);
        DataManager.saveGroups(groups);
        notifyObservers();
    }
    	
