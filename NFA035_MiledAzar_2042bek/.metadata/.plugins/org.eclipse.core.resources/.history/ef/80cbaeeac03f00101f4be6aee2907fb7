public class ContactsWindow extends JFrame implements MyObserver {

	private static final long serialVersionUID = 1L;
	private JPanel contentPane;
	private JTextField txtSearch;
	private ContactController contactController;
	private JList<Contact> contactsList;
    private DefaultListModel<Contact> listModel;
    
    @Override
	public void update() {
	    listModel.clear();
	    Collection<Contact> contacts = contactController.getAllContacts();
	    for (Contact c : contacts) {
	        listModel.addElement(c);
	    }
	}
    
 

    private void updateContactList(Collection<Contact> contacts) {
        listModel.clear();
        for (Contact c : contacts) {
            listModel.addElement(c);
        }
    }

    private void performLiveSearch() {
        String txt = txtSearch.getText().trim();
        if (txt.isEmpty()) {
            update(); 
        } else {
            ArrayList<Contact> sorted = contactController.getContactsByPrefix(txt); 
            updateContactList(sorted);
        }
    }



	/**
	 * Launch the application.
	 */
	public static void main(String[] args) {
		EventQueue.invokeLater(new Runnable() {
			public void run() {
				try {
					ContactController contactController = new ContactController();  
					ContactsWindow frame = new ContactsWindow(contactController);
					frame.setVisible(true);
				} catch (Exception e) {
					e.printStackTrace();
				}
			}
		});
	}

