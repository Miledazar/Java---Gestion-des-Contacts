package controller;

	import model.Contact;
import model.Group;

import java.io.Serializable;
	import java.util.ArrayList;
import java.util.HashSet;
import java.util.Iterator;
import java.util.Set;


	import data.DataManager;

	public class ContactController extends MyObservable implements Serializable {

		private static final long serialVersionUID = 1L;
		
		private Set<Contact> contacts;
		
		public ContactController() {
			 Set<Contact> loaded = DataManager.loadContacts();
			    contacts = (loaded != null) ? loaded : new HashSet<>();
		}
		
		// Add Contact
		
		public void addContact(Contact contact) {
			contacts.add(contact);
			DataManager.saveContacts(contacts);
			notifyObservers();
		}
		
		// Remove Contact
		
		public void removeContact(Contact contact) {
			contacts.remove(contact);
			DataManager.saveContacts(contacts);
			notifyObservers();
		}
		
		// Get All Contacts
		
		public Set<Contact> getAllContacts(){
			return new HashSet<>(contacts);
		}
		
		 // Find Contact By Name
	    
	    public Contact findContactByName(String name) {
	        for (Contact contact : contacts) {
	            if (contact.getFirstName().equalsIgnoreCase(name)) {
	                return contact;
	            }
	        }
	        return null;
	    }
		
		// Update Contact
		
		public void updateContact(Contact originalContact, Contact updatedContact) {
		   
//		    contacts.remove(originalContact);
//		    originalContact.setFirstName(updatedContact.getFirstName());
//		    originalContact.setLastName(updatedContact.getLastName());
//		    originalContact.setCity(updatedContact.getCity());
//		    originalContact.setPhoneNumbers(updatedContact.getPhoneNumbers());
//		    
//		 
//		    for (Group group : new HashSet<>(originalContact.getGroup())) {
//		        originalContact.removeGroup(group);
//		    }
//
//		    
//		    for (Group group : updatedContact.getGroup()) {
//		        originalContact.addGroup(group);
//		    }
//
//		    contacts.add(originalContact);
			
			
			Iterator<Group> it = originalContact.getGroup().iterator();
			while (it.hasNext()) {
			    Group oldGroup = it.next();
			    if (!updatedContact.getGroup().contains(oldGroup)) {
			        oldGroup.removeContact(originalContact);
			        it.remove(); // remove the group from the contact's groups safely
			    }
			}

			// Add the contact to new groups that are not already there
			for (Group newGroup : updatedContact.getGroup()) {
			    if (!originalContact.getGroup().contains(newGroup)) {
			        newGroup.addContact(originalContact);
			    }
			}

			// Update other fields
			originalContact.setFirstName(updatedContact.getFirstName());
			originalContact.setLastName(updatedContact.getLastName());
			originalContact.setCity(updatedContact.getCity());
			originalContact.setPhoneNumbers(updatedContact.getPhoneNumbers());

			// Save data and notify
			DataManager.saveContacts(contacts);
			notifyObservers();

		}

		// Search by first name prefix
		
		public ArrayList<Contact> searchFirstNameByPrefix(String prefix){

			ArrayList<Contact> byFirstName = new ArrayList<>();
			
			for(Contact contact : contacts) {
				if(contact.getFirstName().toLowerCase().startsWith(prefix.toLowerCase())) {
					byFirstName.add(contact);
				}
				
			}
			
			return byFirstName;
		}
		
