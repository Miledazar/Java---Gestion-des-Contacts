		public Set<Contact> getContactsSortedByFirstName() {
			Set<Contact> sorted = new HashSet<>(contacts);
		    return sorted;
		}
		
		// Sort by last name
		public ArrayList<Contact> getContactsSortedByLastName() {
		    ArrayList<Contact> sorted = new ArrayList<>(contacts);
		    sorted.sort((c1, c2) -> c1.getLastName().compareToIgnoreCase(c2.getLastName()));
		    return sorted;
		}

		// Sort by city
		public ArrayList<Contact> getContactsSortedByCity() {
		    ArrayList<Contact> sorted = new ArrayList<>(contacts);
		    sorted.sort((c1, c2) -> c1.getCity().compareToIgnoreCase(c2.getCity()));
		    return sorted;
		}
		
	
	}


